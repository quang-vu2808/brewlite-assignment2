@startuml
title Task 2.1 - Activity Diagram: UC-18 Checkout
skinparam shadowing false
skinparam backgroundColor white
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #42546B
  DiamondBackgroundColor #FFF4CC
  DiamondBorderColor #B08900
  StartColor #2E7D32
  EndColor #B3261E
  FontName Arial
}

|Customer|
start
:Review cart;
repeat
  |Customer|
  :Enter promotion code or skip;
  |Next.js UI|
  :Submit optional promotion code;
  |NestJS API|
  :Validate promotion and eligibility;
  if (No code or valid code?) then (yes)
    :Calculate trusted total;
  else (invalid)
    |Next.js UI|
    :Show invalid/expired code;
    |Customer|
    :Correct code or remove it;
  endif
repeat while (Invalid code not corrected or removed?) is (yes) not (no)

if (JWT session valid?) then (yes)
else (no)
  repeat
    |Next.js UI|
    :Request register/login;
    |Customer|
    :Submit credentials;
    |NestJS API|
    :Verify credentials;
    if (Credentials valid?) then (yes)
      :Issue JWT;
      |Next.js UI|
      :Resume checkout;
    else (no)
      |Next.js UI|
      :Show login error;
      |Customer|
      if (Retry login?) then (yes)
      else (no)
        stop
      endif
    endif
  repeat while (Login failed?) is (yes) not (no)
endif

repeat
|Next.js UI|
:Submit cart and valid optional promotion code;
|NestJS API|
:Validate JWT, DTO, product/options; recalculate trusted prices;
if (Cart valid?) then (yes)
else (no)
  :Return validation error;
  |Next.js UI|
  :Show error; retain cart;
  stop
endif
|Database|
:BEGIN order transaction;
:Check inventory and optimistic version;
if (Enough stock?) then (yes)
  :Save Order(PENDING) and OrderItems;
  :Update/reserve stock;
  :COMMIT;
else (no)
  :ROLLBACK;
  |Next.js UI|
  :Report unavailable quantity; retain cart;
  |Customer|
  if (Adjust cart and retry?) then (yes)
    :Adjust cart;
  else (no)
    stop
  endif
endif
repeat while (Out of stock and cart adjusted?) is (yes) not (no)

repeat
  |Customer|
  :Choose Wallet or Card; confirm payment;
  |Next.js UI|
  :POST /payments with Idempotency-Key;
  |NestJS API|
  :Check order owner, amount, status and request key;
  if (Same key already handled?) then (yes)
    :Return stored result;
  else (new key)
    |Mock Payment Service|
    :Process simulated payment;
    if (Payment succeeds?) then (yes)
      |Database|
      :BEGIN result transaction;
      :Save Payment SUCCESS; transition Order to PAID;
      :Record Loyalty once per order;
      :COMMIT;
    else (no)
      |Database|
      :BEGIN result transaction;
      :Save Payment FAILED; transition Order to PAYMENT_FAILED;
      :COMMIT;
    endif
  endif
  |NestJS API|
  if (Final result is PAID?) then (yes)
    |Next.js UI|
    :Show order confirmation;
    :Clear cart;
  else (no)
    |Next.js UI|
    :Show failure; keep cart;
    |Customer|
    if (Retry same order?) then (yes)
      :Use a new key for the new attempt;
    else (no)
    endif
  endif
repeat while (Confirmed failure and customer retries?) is (yes) not (no)

|Customer|
:View order status/history;
stop
note right
A network replay of the same request reuses the same key.
A new attempt after a confirmed failure uses a new key.
end note
@enduml
