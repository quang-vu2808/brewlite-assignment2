@startuml
title Task 2.2 - Sequence Diagram: UC-18 Đặt và thanh toán
autonumber
hide footbox
skinparam shadowing false
actor Customer
participant "Next.js UI" as UI
participant "NestJS API" as API
database PostgreSQL as DB
participant "Mock Payment Service" as Pay

Customer -> UI: Confirm cart; optional promotion
opt Customer needs to sign in
  UI -> API: POST /auth/login or /auth/register
  API --> UI: User profile + JWT
end
UI -> API: POST /orders\nBearer JWT, items, promotionCode?
activate API
API -> API: Validate JWT/DTO; recalculate trusted prices
opt Promotion code provided
  API -> DB: Validate promotion and eligibility
  DB --> API: Promotion result
end
alt Invalid request
  API --> UI: 400 validation error
  UI --> Customer: Show error; keep cart
else Valid request
  group Transaction 1: create order and update inventory
    API -> DB: BEGIN
    API -> DB: Read stock/version for requested products
    alt Insufficient stock or version conflict
      API -> DB: ROLLBACK
      API --> UI: 409 inventory conflict
      UI --> Customer: Explain unavailable items; keep cart
    else Sufficient stock
      API -> DB: INSERT Order(PENDING), OrderItems
      API -> DB: UPDATE/reserve stock with version check
      API -> DB: COMMIT
      DB --> API: orderId and total
      API --> UI: 201 Created
      UI --> Customer: Show order and payment choices
    end
  end
end

opt Order created successfully; customer starts payment
  Customer -> UI: Choose Wallet/Card and confirm
  UI -> API: POST /payments\nBearer JWT + Idempotency-Key
  API -> DB: Lookup key and verify order ownership/state
  alt Same key and same payload
    DB --> API: Previously saved result
    API --> UI: Replay result; no duplicate processing
  else Same key and changed payload
    API --> UI: 409 idempotency conflict
  else New payment request
    API -> Pay: Process mock payment (outside DB transaction)
    alt Payment succeeds
      Pay --> API: SUCCESS
      group Transaction 2: record payment result
        API -> DB: BEGIN
        API -> DB: Save Payment; transition Order to PAID
        API -> DB: Record LoyaltyTransaction once
        API -> DB: COMMIT
      end
      API --> UI: Confirmation (PAID, orderId, total)
      UI --> Customer: Show order confirmation
      UI -> UI: Clear cart
    else Payment fails
      Pay --> API: FAILED
      group Transaction 2: record payment result
        API -> DB: BEGIN
        API -> DB: Save Payment; transition Order to PAYMENT_FAILED
        API -> DB: COMMIT
      end
      API --> UI: Failure result
      UI --> Customer: Show failure; keep cart
    end
  end
end
deactivate API
@enduml
