@startuml
title Task 2.3 - Class Diagram: BrewLite Domain
skinparam classAttributeIconSize 0
hide empty methods
skinparam shadowing false

class User {
  +id: UUID
  +email: string
  -passwordHash: string
  +loyaltyPoints: integer
  +role: UserRole
}
class Product {
  +id: integer
  +name: string
  +description: string
  +basePrice: integer
  +stockQuantity: integer
  +version: integer
  +isAvailable: boolean
}
class Order {
  +id: UUID
  +userId: UUID
  +status: OrderStatus
  +subtotal: integer
  +discountAmount: integer
  +totalAmount: integer
  +promotionId: UUID?
  +createdAt: DateTime
}
class OrderItem {
  +id: UUID
  +orderId: UUID
  +productId: integer
  +productNameSnapshot: string
  +size: ProductSize
  +toppings: ToppingSnapshot[]
  +quantity: integer
  +unitPrice: integer
  +lineTotal: integer
}
class Payment {
  +id: UUID
  +orderId: UUID
  +idempotencyKey: string
  +payloadHash: string
  +method: PaymentMethod
  +status: PaymentStatus
  +amount: integer
  +createdAt: DateTime
}
class Promotion {
  +id: UUID
  +code: string
  +discountType: DiscountType
  +discountValue: integer
  +maxDiscount: integer
  +startsAt: DateTime
  +endsAt: DateTime
  +isActive: boolean
}
class LoyaltyTransaction {
  +id: UUID
  +userId: UUID
  +orderId: UUID
  +pointsDelta: integer
  +createdAt: DateTime
}
enum UserRole {
  CUSTOMER
  STAFF
}
enum ProductSize {
  S
  M
  L
}
enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  WALLET
  CARD
}
enum PaymentStatus {
  SUCCESS
  FAILED
}
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : contains
Product "1" -- "0..*" OrderItem : selected in
Order "1" -- "0..*" Payment : attempts
Order "0..*" -- "0..1" Promotion : uses
User "1" -- "0..*" LoyaltyTransaction : earns
Order "1" -- "0..1" LoyaltyTransaction : awards once
note bottom of Product
Product stock/version supports the required
inventory check and optimistic locking.
end note
@enduml
