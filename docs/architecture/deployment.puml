@startuml
title BrewLite - Deployment Architecture and Release Workflow
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #52677E
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #46566B
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #46566B
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #46566B
}

package "DEVELOPMENT" as DEV_ENV #F2F7FC {
  node "Developer workstation\nVS Code · Git" as WORKSTATION
  node "Docker Compose\nNext.js · NestJS · PostgreSQL" as LOCAL_STACK
  WORKSTATION --> LOCAL_STACK : local development
}

package "SOURCE CONTROL & DELIVERY PIPELINE" as PIPELINE #F5F2FC {
  artifact "GitHub repository\nSource · documentation · workflow" as REPO
  node "GitHub Actions release workflow\nInstall → Lint → Tests → Build\nPublish versioned images\nApply database migrations\nDeploy services and run smoke checks\nRollback to last known good release on failure" as CI
}

package "CONTAINER REGISTRY" as REGISTRY #FFF7E8 {
  node "GitHub Container Registry" as GHCR
  artifact "brewlite-api:<commit-sha-or-version>" as API_IMAGE
  GHCR --> API_IMAGE : immutable version tag
}

package "PRODUCTION" as PROD #EFF8F4 {
  node "Customer browser\nDesktop or mobile" as CLIENT
  node "Next.js Web Service\nFrontend build\nHTTPS production URL" as WEB
  node "NestJS API Service\nAPI URL · GET /health\nMock Payment Adapter" as API
  database "Managed PostgreSQL\nPrivate network · persistent storage" as DB
  artifact "Runtime secrets\nDATABASE_URL · JWT_SECRET · PORT" as SECRETS
  CLIENT --> WEB : HTTPS
  WEB --> API : REST/JSON over HTTPS
  API --> DB : PostgreSQL :5432
  SECRETS ..> WEB : inject at runtime
  SECRETS ..> API : inject at runtime
}

package "RELEASE & HANDOFF" as HANDOFF #FFF9E8 {
  artifact "Release tag and notes" as RELEASE
  artifact "README\nLocal · test · build · deploy · rollback" as README
  artifact "End-to-end demo" as DEMO
  artifact "Sprint Review and Retrospective" as REVIEW
  artifact "Acceptance\nReviewer can clone, run, and open\nthe production URLs" as ACCEPT
  RELEASE -[hidden]right- README
  README -[hidden]right- DEMO
  DEMO -[hidden]right- REVIEW
  REVIEW -[hidden]right- ACCEPT
}

WORKSTATION --> REPO : commit and push
REPO --> CI : push or release tag
CI --> GHCR : publish API image
API_IMAGE --> API : deploy exact version
CI --> WEB : deploy web service
CI --> API : deploy API service
CI --> DB : apply safe schema migration

note right of PROD
The database has no public endpoint.
Production URLs use HTTPS.
Secrets stay in platform settings,
outside repository files and CI logs.
end note
@enduml
